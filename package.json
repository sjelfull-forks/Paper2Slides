{
  "name": "paper2slides",
  "version": "2.0.0",
  "private": true,
  "description": "Paper2Slides - Convert research papers to professional slides",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
