{
  "name": "@paper2slides/database",
  "version": "0.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:generate:sqlite": "drizzle-kit generate --config=drizzle.config.sqlite.ts",
    "db:generate:pglite": "drizzle-kit generate --config=drizzle.config.pglite.ts",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:push:sqlite": "drizzle-kit push --config=drizzle.config.sqlite.ts",
    "db:push:pglite": "drizzle-kit push --config=drizzle.config.pglite.ts",
    "db:studio": "drizzle-kit studio",
    "db:studio:sqlite": "drizzle-kit studio --config=drizzle.config.sqlite.ts",
    "db:studio:pglite": "drizzle-kit studio --config=drizzle.config.pglite.ts",
    "db:seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.0",
    "better-sqlite3": "^11.7.0",
    "drizzle-orm": "^0.40.0",
    "drizzle-zod": "^0.8.3",
    "postgres": "^3.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^20.12.7",
    "drizzle-kit": "^0.31.2",
    "tsx": "^4.19.2"
  }
}
