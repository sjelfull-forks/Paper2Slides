# Database Configuration
# Option 1: PGlite (Recommended for local development - no PostgreSQL needed!)
USE_PGLITE=true

# Option 2: PostgreSQL (Comment out USE_PGLITE and uncomment below)
# DATABASE_URL=postgresql://user:password@localhost:5432/paper2slides

# OpenAI API Key (Required for TypeScript backend)
OPENAI_API_KEY=your_openai_api_key_here

# File Upload Settings
UPLOAD_DIR=./sources/uploads
OUTPUT_DIR=./outputs
MAX_FILE_SIZE=50000000

# Next.js Public URL (for client-side API calls)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Optional: Python Backend (Legacy - TypeScript backend is now default)
# PYTHON_BACKEND_URL=http://localhost:8000

# PGlite Configuration (when USE_PGLITE=true)
# Data stored in ./pglite-data by default
# Use :memory: for in-memory testing database
# PGLITE_DATA_DIR=./pglite-data

# Optional: Other AI providers
# ANTHROPIC_API_KEY=your_anthropic_key
# GOOGLE_API_KEY=your_google_key
