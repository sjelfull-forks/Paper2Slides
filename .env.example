# Database Configuration
# Choose one of three options (SQLite is default):

# Option 1: SQLite (DEFAULT - Recommended for local development)
# No configuration needed! SQLite works out of the box.
# Data stored in ./sqlite.db file
# SQLITE_DB_PATH=./sqlite.db

# Option 2: PGlite (PostgreSQL-compatible, WASM-based)
# Uncomment to use PGlite instead of SQLite
# USE_PGLITE=true
# PGLITE_DATA_DIR=./pglite-data

# Option 3: PostgreSQL (Production)
# Uncomment to use full PostgreSQL
# DATABASE_URL=postgresql://user:password@localhost:5432/paper2slides

# OpenAI API Key (Required for TypeScript backend)
OPENAI_API_KEY=your_openai_api_key_here

# File Upload Settings
UPLOAD_DIR=./sources/uploads
OUTPUT_DIR=./outputs
MAX_FILE_SIZE=50000000

# Next.js Public URL (for client-side API calls)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Optional: Python Backend (Legacy - TypeScript backend is now default)
# PYTHON_BACKEND_URL=http://localhost:8000

# Optional: Other AI providers
# ANTHROPIC_API_KEY=your_anthropic_key
# GOOGLE_API_KEY=your_google_key
